from bolt_expressions import Scoreboard, Data

dummy = Scoreboard("coc.dummy")
atSelf = Data.entity("@s")
temp = Data.storage("coc:temp")


CURSOR_X = dummy["$x"]
CURSOR_Y = dummy["$y"]
CURSOR_D = Scoreboard("coc.cursor.d")["@s"]
CURSOR_R = Scoreboard("coc.cursor.r")["@s"]

SCREEN_W = Scoreboard("coc.screen.w")["@s"]
SCREEN_H = Scoreboard("coc.screen.h")["@s"]

SCREEN_PPU = Scoreboard("coc.screen.ppu")["@s"]


append function coc:modules/in_world_ui/replace_ui:
    as @e[tag=coc.world_ui] if score @s coc.dummy = $id coc.dummy function coc:modules/in_world_ui/kill_children:
        on passengers function coc:modules/in_world_ui/kill_children
        kill @s

class Screen:
    def __init__(self, name, w, h, d, ppu=16, children=[]):
        self.name = name.lower()
        self.w = int(w)
        self.h = int(h)
        self.d = int(d)
        self.children = children
        self.ppu = int(ppu)

    def generate(self):
        append function f"coc:modules/ui/{self.name}/create":
            Scoreboard("coc.cursor.r")["@s"] = atSelf.Rotation[0] * 1000
            dummy["$r"] = CURSOR_R
            CURSOR_D = self.d * 100
            function f"coc:modules/ui/{self.name}/swap"

        append function f"coc:modules/ui/{self.name}/swap":
            dummy["$id"] = Scoreboard("coc.player_id")["@s"]

            if entity @s[tag=coc.has_tracked_ui] function coc:modules/in_world_ui/replace_ui

            SCREEN_W = self.w
            SCREEN_H = self.h
            SCREEN_PPU = self.ppu

            tag @s add coc.has_tracked_ui

            anchored eyes positioned ^ ^ ^0 anchored feet positioned ~ ~-0.001 ~ summon text_display function f"coc:modules/ui/{self.name}/setup":
                tag @s add coc.world_ui
                tag @s add f"coc.ui.{self.name}"
                tag @s add coc.element

                dummy["@s"] = dummy["$id"]

                execute summon interaction function f"coc:modules/ui/{self.name}/interaction":
                    data merge entity @s {width:0.06, height:0.06, Tags:[f"coc.ui.{self.name}.interaction", "coc.element"]}
                    ride @s mount @e[type=text_display,tag=f"coc.ui.{self.name}",sort=nearest,limit=1]

                for c in self.children:
                    c.render(self)

        tick_path = f"coc:modules/ui/{self.name}/tick"
        append function tick_path:
            store result entity @s Air byte 1 time query gametime
            for c in self.children:
                c.tick(self, self, tick_path)



        left_click_path = f"coc:modules/ui/{self.name}/left_click"

        advancement f"coc:events/ui/{self.name}/left_click" {
            "criteria": {
                "requirement": {
                    "trigger": "minecraft:player_hurt_entity",
                    "conditions": {
                        "entity": {
                            "nbt": ('{Tags:["' + f"coc.ui.{self.name}.interaction" + '"]}')
                        }
                    }
                }
            },
            "rewards": {
                "function": left_click_path
            }
        }

        append function left_click_path:
            advancement revoke @s only f"coc:events/ui/{self.name}/left_click"

            dummy["$id"] = Scoreboard("coc.player_id")["@s"]
            as @e[type=text_display,tag=f"coc.ui.{self.name}"] if score var dummy["@s"] = var dummy["$id"] on passengers function (left_click_path + "/run"):
                for c in self.children:
                    c.left_click(left_click_path)

        append function coc:modules/in_world_ui/track_player:
            if entity @s[tag=f"coc.ui.{self.name}"] on passengers function tick_path

