from bolt_expressions import Scoreboard, Data
VIEW_RANGE = Float(0.00003)

dummy = Scoreboard("coc.dummy")
atSelf = Data.entity("@s")

def fix_rotation():
    rotation = atSelf.Rotation(type='float')
    rotation[0] = dummy["$r"] / 1000

class Element:
    def __init__(self, x, y, w, h):
        self.x = int(x)
        self.y = int(y)
        self.w = int(w)
        self.h = int(h)

    def get_transform(self, screen, depth, offset=0.5):
        scale = Float(2.5 * (16/screen.ppu))

        return {
            translation: [Float(((screen.w/2) - self.x - (self.w/2)) / screen.ppu), Float((self.y - (screen.h/2)) / screen.ppu), Float(screen.d - depth)],
            scale: [scale,scale,scale],
            left_rotation: [0f,1f,0f,0f],
            right_rotation: [0f,0f,0f,1f]
        }

    def render(self, screen, depth=0):
        pass

    def tick(self, screen, parent, path):
        pass

    @classmethod
    def generic_tick(self):
        pass

    def left_click(self, path):
        pass
    def right_click(self, path):
        pass